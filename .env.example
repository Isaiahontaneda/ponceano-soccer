# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local a Git.

# URL del proyecto de Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Llave publishable (sb_publishable_...). Es pública, pero no tiene permisos sobre las tablas.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Llave secret (sb_secret_...). SOLO servidor: jamás con prefijo NEXT_PUBLIC_ ni en el navegador.
SUPABASE_SECRET_KEY=
